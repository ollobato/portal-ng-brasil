rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra geral existente (inalterada), exceto para as coleções comerciais,
    // que contêm dados pessoais de anunciantes e NÃO podem ser lidas publicamente.
    match /{col}/{document=**} {
      allow read: if col != 'commercial_leads' && col != 'commercial_rate_limits';
      allow write: if request.auth != null && col != 'commercial_rate_limits';
    }
    match /drafts/{draftId} {
      allow read: if true;
      allow write: if true;
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // CRM comercial: leitura, edição e exclusão EXCLUSIVAS para usuários autenticados (painel Admin).
    // Criação é permitida para administradores autenticados (cadastro manual no CRM)
    // OU para requisições públicas validadas campo a campo (da landing page /anuncie/).
    match /commercial_leads/{leadId} {
      allow read, update, delete: if request.auth != null;
      allow create: if (request.auth != null) || (
        leadId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$') &&
        request.resource.data.keys().hasAll(['requestId', 'name', 'company', 'email', 'goal', 'consent', 'status', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['requestId', 'name', 'company', 'email', 'phone', 'goal', 'region', 'budget', 'message', 'consent', 'consentVersion', 'offer', 'utm', 'status', 'createdAt', 'updatedAt', 'activity']) &&
        request.resource.data.requestId == leadId &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
        request.resource.data.company is string && request.resource.data.company.size() >= 2 && request.resource.data.company.size() <= 180 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 180 && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
        request.resource.data.goal in ['Conhecimento da marca', 'Visitas e contatos', 'Vendas de um produto', 'Patrocínio recorrente'] &&
        request.resource.data.consent == true &&
        request.resource.data.status == 'novo'
      );
    }
    // Controle de limite de envios: acesso apenas pelo servidor.
    match /commercial_rate_limits/{hash} {
      allow read, write: if false;
    }
  }
}
