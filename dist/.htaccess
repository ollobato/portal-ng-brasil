<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Imagem direta da matéria para Open Graph / WhatsApp (ex: /imagem-materia/12345.jpg)
  RewriteRule ^imagem-materia/([0-9a-zA-Z_-]+)\.(jpg|jpeg|png|webp)$ /image.php?id=$1 [L,QSA]

  # 2. Rotas de Aprovação / Revisão (ex: /aprovacao/12345)
  RewriteRule ^(aprovacao|revisao|aprovar)/([0-9a-zA-Z_-]+)/?$ /aprovacao.php?id=$2 [L,QSA]

  # 3. Rotas de Notícia / Matéria pública (ex: /noticia/12345 ou /materia/12345)
  RewriteRule ^(noticia|materia)/([0-9a-zA-Z_-]+)/?$ /aprovacao.php?id=$2&type=noticia [L,QSA]

  # 4. Arquivos e diretórios existentes físicos
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
